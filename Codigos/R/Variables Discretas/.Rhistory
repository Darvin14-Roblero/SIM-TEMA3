library(shiny)
# --- INTERFAZ DE USUARIO (UI) ---
ui <- fluidPage(
titlePanel("Variable Aleatoria Discreta - Suma de 2 Dados"),
sidebarLayout(
sidebarPanel(
actionButton("lanzar1", "Lanzar 1 Vez", class = "btn-primary"),
br(), br(),
actionButton("lanzar1000", "Simular 1,000 Lanzamientos", class = "btn-success"),
br(), br(),
actionButton("reiniciar", "Reiniciar Simulación", class = "btn-danger"),
hr(),
h4("Estadísticas"),
textOutput("lbl_ultimo"),
textOutput("lbl_total")
),
mainPanel(
tabsetPanel(
tabPanel("Gráfico de Distribución", plotOutput("grafico")),
tabPanel("Tabla de Frecuencias y Probabilidades", tableOutput("tabla"))
)
)
)
)
# --- LÓGICA DEL SERVIDOR ---
server <- function(input, output, session) {
# Valores reactivos para almacenar los lanzamientos acumulados
datos <- reactiveValues(lanzamientos = c())
# Evento: Lanzar 1 vez
observeEvent(input$lanzar1, {
dado1 <- sample(1:6, 1)
dado2 <- sample(1:6, 1)
datos$lanzamientos <- c(datos$lanzamientos, dado1 + dado2)
})
# Evento: Simular 1,000 lanzamientos
observeEvent(input$lanzar1000, {
dados1 <- sample(1:6, 1000, replace = TRUE)
dados2 <- sample(1:6, 1000, replace = TRUE)
nuevos <- dados1 + dados2
datos$lanzamientos <- c(datos$lanzamientos, nuevos)
})
# Evento: Reiniciar
observeEvent(input$reiniciar, {
datos$lanzamientos <- c()
})
# Salidas de Texto
output$lbl_ultimo <- renderText({
if (length(datos$lanzamientos) == 0) return("Último resultado: -")
paste("Último resultado:", tail(datos$lanzamientos, 1))
})
output$lbl_total <- renderText({
paste("Total de lanzamientos:", length(datos$lanzamientos))
})
# Salida de la Tabla
output$tabla <- renderTable({
n <- length(datos$lanzamientos)
x_val <- 2:12
# Probabilidad Teórica
prob_teorica <- c(1, 2, 3, 4, 5, 6, 5, 4, 3, 2, 1) / 36
if (n == 0) {
freq <- rep(0, 11)
prob_obs <- rep(0, 11)
} else {
freq <- sapply(x_val, function(v) sum(datos$lanzamientos == v))
prob_obs <- freq / n
}
data.frame(
`Valor X (Suma)` = x_val,
`Frecuencia Absoluta` = as.integer(freq),
`Prob. Observada P(X)` = sprintf("%.4f", prob_obs),
`Prob. Teórica P(X)` = sprintf("%.4f", prob_teorica),
check.names = FALSE
)
})
# Salida del Gráfico de Barras
output$grafico <- renderPlot({
n <- length(datos$lanzamientos)
x_val <- 2:12
prob_teorica <- c(1, 2, 3, 4, 5, 6, 5, 4, 3, 2, 1) / 36
if (n == 0) {
prob_obs <- rep(0, 11)
} else {
freq <- sapply(x_val, function(v) sum(datos$lanzamientos == v))
prob_obs <- freq / n
}
# Superposición de Probabilidad Observada vs Teórica
matriz <- rbind(prob_obs, prob_teorica)
barplot(
matriz,
beside = TRUE,
names.arg = x_val,
col = c("#3498db", "#e74c3c"),
main = "Comparativa: Probabilidad Observada vs. Teórica",
xlab = "Suma de dos dados (Variable X)",
ylab = "Probabilidad",
ylim = c(0, 0.2)
)
legend("topright", legend = c("Observada (Simulada)", "Teórica"),
fill = c("#3498db", "#e74c3c"))
})
}
# --- EJECUTAR APLICACIÓN ---
shinyApp(ui = ui, server = server)
