# Parámetros
set.seed(123)       # Semilla para reproducibilidad
n <- 1000           # Cantidad de variables a generar
lambda <- 2         # Parámetro de la distribución exponencial
# 1. Generar variables uniformes U ~ U(0,1)
u <- runif(n)
# 2. Aplicar la función inversa acumulada: X = -ln(1 - U) / lambda
x_simuladas <- -log(1 - u) / lambda
# Visualización y comparación con la densidad teórica
hist(x_simuladas, probability = TRUE, breaks = 30,
main = "Generación de Variable Exponencial (R)",
xlab = "x", ylab = "Densidad", col = "lightblue", border = "white")
curve(dexp(x, rate = lambda), add = TRUE, col = "red", lwd = 2)
legend("topright", legend = c("Simulado", "Teórico (dexp)"),
fill = c("lightblue", NA), border = c("white", NA),
col = c(NA, "red"), lty = c(0, 1), lwd = c(0, 2))
# Parámetros (sin fijar semilla)
n <- 1000
lambda <- 2
# 1. Generar variables uniformes U ~ U(0,1)
u <- runif(n)
# 2. Aplicar la función inversa acumulada
x_simuladas <- -log(1 - u) / lambda
# Visualización
hist(x_simuladas, probability = TRUE, breaks = 30,
main = "Generación de Variable Exponencial (R)",
xlab = "x", ylab = "Densidad", col = "lightblue", border = "white")
curve(dexp(x, rate = lambda), add = TRUE, col = "red", lwd = 2)
